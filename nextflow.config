process {
    withName:count_individuals {
        container = 'mrcieu/pipeline-nf-haplotype-components:bcftools-1.24'
    }
    withName:count_snps {
        container = 'mrcieu/pipeline-nf-haplotype-components:bcftools-1.24'
    }
    withName:paint {
        container = 'mrcieu/pipeline-nf-haplotype-components:pbwt-2.1'
        shell = ['/bin/sh', '-ue']
        maxForks = 10
    }
    withName:generate_chunk_length_matrix {
        container = 'mrcieu/pipeline-nf-haplotype-components:combine-v0.6.0'
        shell = ['/bin/sh', '-ue']
    }
    withName:compute_HCs {
        container = 'mrcieu/pipeline-nf-haplotype-components:calculate_HCs'
    }
}

profiles {
    // small test dataset: 300 1000G samples, every 10th HapMap 3 SNP (see testdata/make_testdata.sh)
    test {
        params.vcf_file_list = "${projectDir}/testdata/vcf_list.txt"
        params.map_file = "${projectDir}/testdata/map_lengths.txt"
        params.nHCs = 10
        // the test data is thinned 10x, and has few samples, so lower the match-length cutoff (SNPs)
        params.paint_cutoff = 20
    }
}

docker {
    enabled = true
    runOptions = '--user $(id -u):$(id -g)'
}
