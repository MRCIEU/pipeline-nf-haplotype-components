process {
    withName:count_individuals {
        container = 'mrcieu/pipeline-nf-haplotype-components:bcftools-1.24'
    }
    withName:count_snps {
        container = 'mrcieu/pipeline-nf-haplotype-components:bcftools-1.24'
    }
    withName:paint {
        container = 'mrcieu/pipeline-nf-haplotype-components:pbwt-2.1'
        shell = ['/bin/sh', '-ue']
        maxForks = 10
    }
    withName:generate_chunk_length_matrix {
        container = 'mrcieu/pipeline-nf-haplotype-components:combine-v0.3.0'
        shell = ['/bin/sh', '-ue']
    }
    withName:compute_HCs {
        container = 'mrcieu/pipeline-nf-haplotype-components:calculate_HCs'
    }
}

docker {
    enabled = true
    runOptions = '--user $(id -u):$(id -g)'
}
