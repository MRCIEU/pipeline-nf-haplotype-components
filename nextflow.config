process {
    withName:count_individuals {
        container = 'mrcieu/hcs-dev:bcftools-1.24'
    }
    withName:count_snps {
        container = 'mrcieu/hcs-dev:bcftools-1.24'
    }
    withName:paint {
        container = 'mrcieu/hcs-dev:pbwt-2.1'
        shell = ['/bin/sh', '-ue']
        maxForks = 10
    }
    withName:generate_chunk_length_matrix {
        container = 'mrcieu/hcs-dev:combine'
        shell = ['/bin/sh', '-ue']
    }
    withName:compute_HCs {
        container = 'mrcieu/hcs-dev:calculate_HCs'
    }
}

docker {
    enabled = true
    runOptions = '--user $(id -u):$(id -g)'
}
